{
  "name": "@outlet/api",
  "version": "2.3.7",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    }
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node ./scripts/bundle-dashboards.mjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:tenants": "medusa exec ./src/scripts/tenants.ts",
    "ensure:admin": "medusa exec ./src/scripts/ensure-admin.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "codegen": "node ./scripts/codegen.mjs",
    "cloud:prebuild": "mercurjs codegen"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/core-flows": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@mercurjs/cli": "2.3.7",
    "@mercurjs/core": "2.3.7",
    "@mercurjs/types": "2.3.7",
    "http-proxy-middleware": "3.0.7",
    "multer": "2.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@outlet/admin": "workspace:*",
    "@outlet/vendor": "workspace:*",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "cross-env": "^10.1.0",
    "@types/multer": "2.0.0",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
